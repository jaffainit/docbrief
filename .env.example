# Postgres / Neon (pooled + direct for Prisma migrate)
DATABASE_URL="postgresql://USER:PASS@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@HOST/neondb?sslmode=require"

# Auth: email + bcrypt password; httpOnly session cookie (docbrief_uid).
# AUTH_COOKIE_NAME=docbrief_uid
# SESSION_MAX_AGE_DAYS=30

# Optional — polish script + TTS voiceover via OpenAI
OPENAI_API_KEY=

# Stripe Checkout (Starter $12/mo, Creator $36/mo).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_CREATOR=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Vercel Blob (durable audio/video/zip on serverless). Auto-injected when store linked.
BLOB_READ_WRITE_TOKEN=

# Canonical app URL for Checkout success/cancel/portal and verify links.
# Localhost / 127.0.0.1 values are ignored in production (falls back to https://docbrief.wedgewerks.win).
NEXT_PUBLIC_APP_URL=https://docbrief.wedgewerks.win

# Resend — email verification (required to unlock free credit) + welcome email.
# Without RESEND_API_KEY, signup still works; verify URL is logged server-side; emailed:false.
# Unverified custom From domains fall back to beth.t@example.com.
RESEND_API_KEY=
# EMAIL_FROM=DocBrief <onboarding@docbrief.wedgewerks.win>
