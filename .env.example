# Local SQLite (default). For Postgres/Neon, change prisma/schema.prisma
# provider to "postgresql" and set a Postgres URL (+ optional DIRECT_URL).
DATABASE_URL="file:./dev.db"

# Auth: email + bcrypt password; httpOnly session cookie (docbrief_uid).
# AUTH_COOKIE_NAME=docbrief_uid
# SESSION_MAX_AGE_DAYS=30

# Optional — polish script + TTS voiceover via OpenAI
OPENAI_API_KEY=

# Stripe Checkout (Starter $12/mo, Creator $36/mo).
# All required for live billing — missing keys → 503 + config notice (no stub free upgrade).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_CREATOR=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App URL (optional; Checkout success URLs use request origin)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
